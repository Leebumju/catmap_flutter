<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Supabase(REST/Realtime)와 이미지 로딩이 전부 네트워크다.
         debug 매니페스트의 INTERNET 은 개발 도구용이라 release 빌드에는 합쳐지지 않는다. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 목격 위치를 기록하고 지도에 내 위치를 표시하는 데 쓴다.
         geolocator 플러그인은 권한을 스스로 선언하지 않으므로 앱이 직접 넣어야 한다.
         iOS 의 NSLocationWhenInUseUsageDescription 에 해당한다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- 카메라 권한은 camera 플러그인이 선언한다. 다만 그 플러그인은 동영상용
         RECORD_AUDIO 까지 같이 선언하는데, 이 앱은 사진만 찍는다(enableAudio: false).
         지우지 않으면 스토어에 "마이크" 권한이 표시된다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- screenOrientation: iOS 의 UISupportedInterfaceOrientations 가 세로 하나뿐이다.
             피드가 세로 페이저라 가로에서는 레이아웃이 성립하지 않는다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- 로그인 후 브라우저가 돌아오는 주소.
                 iOS 의 CFBundleURLSchemes "catmap" 과 같은 값이어야 한다
                 (Supabase 에 등록된 redirect 주소가 catmap://login-callback). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="catmap" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- AdMob 앱 ID. 이게 없으면 앱이 시작하자마자 죽는다.
             지금 값은 구글 공식 테스트 ID 다. AdMob 콘솔에서 안드로이드 앱을 만들고
             발급받은 실제 ID(ca-app-pub-...~...)로 바꿔야 수익이 잡힌다.
             iOS 의 GADApplicationIdentifier 는 애플용이라 그대로 쓸 수 없다. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
